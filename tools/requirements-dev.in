# Dev/test-only dependencies for llama-ai (pytest for the test suite).
# SINGLE source of truth for dev deps: compile to requirements-dev.txt via
# `make -C tools generate-requirements-dev` (pip-compile). Never hand-edit
# requirements-dev.txt.
#
#   make -C tools generate-requirements-dev   # compile .in -> .txt
#   make -C tools venv-dev-install            # install runtime + dev deps into venv
pytest==8.3.5
pytest-cov==5.0.0