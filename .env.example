# .env.example — template for local secrets (NO real values — commit this file).
# Copy to `.env` and fill in real values. `.env` is gitignored and NEVER pushed.
#
# GitHub fine-grained personal access token with `Contents: read and write`
# permission on the `asimov-agent/llama-ai` repository. Used by scripts
# (scripts/gh_push.sh etc.) and by git push credential resolution.
GITHUB_TOKEN=
